{
  "name": "vyomtech-erp",
  "version": "1.0.0",
  "description": "VyomTech ERP - Multi-tenant AI-powered ERP System",
  "private": true,
  "workspaces": [
    "frontend",
    "prisma"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "dev:backend": "go run cmd/main.go",
    "dev:frontend": "cd frontend && npm run dev",
    "down": "docker-compose down",
    "build": "docker-compose build",
    "build:backend": "go build -o bin/main ./cmd",
    "build:frontend": "cd frontend && npm run build",
    "lint:frontend": "cd frontend && npm run lint",
    "prisma:generate": "cd prisma && npx prisma generate",
    "prisma:migrate": "cd prisma && npx prisma migrate deploy",
    "prisma:seed": "cd prisma && npx prisma db seed",
    "prisma:reset": "cd prisma && npx prisma migrate reset --force",
    "prisma:studio": "cd prisma && npx prisma studio",
    "prisma:push": "cd prisma && npx prisma db push",
    "setup": "bash scripts/bootstrap.sh",
    "validate": "bash scripts/validate.sh",
    "health-check": "bash system-health-check.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "prisma": "^5.7.1",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "bcryptjs": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
