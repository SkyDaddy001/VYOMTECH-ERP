# VYOMTECH ERP Environment Configuration
# -----------------------------------------------------------------------------
# This file is the template for all application-level environment variables.
# Copy it to .env and fill in the correct values before running the project.
#
# IMPORTANT:
# - Keep platform-wide infrastructure and secret configuration here.
# - Keep tenant-specific configuration in the database (tenant settings table),
#   not in .env, because each tenant can have different branding, SMTP,
#   feature flags, domain names, timezone, and module configuration.
# -----------------------------------------------------------------------------

# =========================
# App / Server
# =========================
APP_NAME=VYOMTECH ERP
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
APP_LOG_LEVEL=info
APP_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =========================
# Database
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vyomtech_erp
DB_USER=vyomtech_user
DB_PASSWORD=your_secure_db_password
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300
DB_MIGRATIONS_AUTO_RUN=true

# =========================
# Redis / Cache
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# =========================
# Authentication / JWT
# =========================
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=vyomtech-erp
JWT_AUDIENCE=vyomtech-erp
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# =========================
# Email / Notifications
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=VYOMTECH ERP
SMTP_USE_TLS=true
SMS_PROVIDER=
WHATSAPP_WEBHOOK_SECRET=
PUSH_NOTIFICATION_KEY=

# =========================
# File Storage / Uploads
# =========================
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10MB
FILES_BASE_URL=http://localhost:8080/uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# =========================
# AI Providers
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORG_ID=
CLAUDE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# =========================
# Asterisk / Telephony
# =========================
ASTERISK_HOST=localhost
ASTERISK_PORT=5038
ASTERISK_USER=admin
ASTERISK_PASSWORD=admin
ASTERISK_TIMEOUT=3000

# =========================
# Security / Crypto
# =========================
PASSWORD_HASH_COST=12
ENCRYPTION_KEY=replace_with_32_char_random_encryption_key
API_RATE_LIMIT=120
API_RATE_LIMIT_WINDOW=1m

# =========================
# Payment Gateways
# =========================
PAYMENT_GATEWAY=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=

# =========================
# OAuth / SSO
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# =========================
# Observability / Monitoring
# =========================
OTEL_SERVICE_NAME=vyomtech-erp
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
PROMETHEUS_ENABLED=false
LOGGLY_TOKEN=

# =========================
# Tenant defaults / system defaults
# =========================
TENANT_DEFAULT_ID=1
TENANT_DEFAULT_LOCALE=en
TENANT_DEFAULT_CURRENCY=INR
TENANT_DEFAULT_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# TENANT-SPECIFIC configuration should be stored in the database, for example:
# - tenant_settings
# - tenant_configurations
# - integrations
# - branding
# - feature_flags
# - custom SMTP / API keys per tenant
# - domain mappings and portal URLs
#
# Keeping tenant-specific values in the database allows each organization to have
# isolated settings while the global platform variables remain environment-based.
# -----------------------------------------------------------------------------
